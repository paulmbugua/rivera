FROM node:22-bookworm-slim AS builder
WORKDIR /app
RUN corepack enable
ENV SITES_PNPM_SHARED_STORE=/pnpm/store PNPM_CONFIG_FETCH_RETRIES=5 PNPM_CONFIG_FETCH_TIMEOUT=300000
COPY . .
RUN --mount=type=cache,id=rivera-pnpm,target=/pnpm/store,sharing=locked pnpm install --frozen-lockfile
RUN pnpm build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production SITES_RUNTIME_ROOT=/tmp/rivera-sites-runtime XDG_CONFIG_HOME=/tmp/rivera-sites-runtime/config
RUN corepack enable && groupadd --system rivera && useradd --system --create-home --gid rivera rivera
COPY --from=builder --chown=rivera:rivera /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
COPY --from=builder --chown=rivera:rivera /app/node_modules ./node_modules
COPY --from=builder --chown=rivera:rivera /app/dist ./dist
COPY --from=builder --chown=rivera:rivera /app/scripts ./scripts
RUN mkdir -p /tmp/rivera-sites-runtime/wrangler /tmp/rivera-sites-runtime/config /app/.wrangler && chown -R rivera:rivera /tmp/rivera-sites-runtime /app/.wrangler
USER rivera
EXPOSE 3000
CMD ["node", "--import", "./scripts/sites-env.mjs", "./node_modules/wrangler/bin/wrangler.js", "dev", "--config", "dist/server/wrangler.json", "--local", "--ip", "0.0.0.0", "--port", "3000", "--inspector-port", "0"]
