riveracreators.com {
	redir https://www.riveracreators.com{uri} permanent
}

www.riveracreators.com {
	encode zstd gzip

	# The Caddy container also joins AllShops' edge network, where `web` is
	# aliased to AllShops. Use Rivera's unique Compose container DNS name.
	reverse_proxy rivera-web-1:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

api.riveracreators.com {
	encode zstd gzip
	# Avoid the shared-network `api` alias resolving to AllShops.
	reverse_proxy rivera-api-1:4000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
