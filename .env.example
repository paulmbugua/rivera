DATABASE_URL=postgresql://rivera:rivera_dev@localhost:5432/rivera?schema=public
POSTGRES_PASSWORD=rivera_dev
POSTGRES_PORT=5432
PORT=4000
WEB_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api/v1
JWT_ACCESS_SECRET=dev-only-change-this-to-a-random-secret-of-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
EMAIL_VERIFICATION_EXPIRES_IN=24h
PASSWORD_RESET_EXPIRES_IN=1h
COOKIE_SECURE=false
# Google OAuth (web server flow)
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
GOOGLE_AUTH_API_URL=http://localhost:4000/api/v1
# Firebase Admin verifies mobile Firebase ID tokens. Prefer the split values
# locally; FIREBASE_SERVICE_ACCOUNT_JSON can supply the complete JSON instead.
FIREBASE_PROJECT_ID=
# The client email/private key are optional for Firebase ID-token signature
# verification. Add them when server-side revocation checks or user management
# are enabled.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
MAIL_PROVIDER=console
MAIL_FROM_NAME=Rivera
MAIL_FROM_ADDRESS=noreply@rivera.example
MAIL_FROM=Rivera <noreply@rivera.example>
MAIL_REPLY_TO=noreply@rivera.example
ADMIN_SEED_EMAIL=admin@rivera.local
ADMIN_SEED_PASSWORD=RiveraDemo123
BUSINESS_SEED_EMAIL=business.demo@example.com
BUSINESS_SEED_PASSWORD=RiveraDemo123
CREATOR_SEED_EMAIL=creator.demo@example.com
CREATOR_SEED_PASSWORD=RiveraDemo123
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_PASSWORD=
SMTP_FROM=

# Phase 3 local media storage (use object storage in production later)
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads
MEDIA_PUBLIC_URL=http://localhost:4000/media
MAX_PROFILE_IMAGE_MB=5
MAX_COVER_IMAGE_MB=10
MAX_PORTFOLIO_IMAGE_MB=10
PRIVATE_UPLOAD_DIR=./private-uploads
MAX_DELIVERABLE_FILE_MB=25
MARKETPLACE_SERVICE_FEE_BPS=1000
MARKETPLACE_SERVICE_FEE_FIXED_MINOR=0
MARKETPLACE_SERVICE_FEE_POLICY=BUSINESS_PAYS_ON_TOP
AUTO_RELEASE_ENABLED=false
AUTO_RELEASE_DELAY_HOURS=72
NEXT_PUBLIC_MEDIA_URL=http://localhost:4000/media

# Phase 4 campaign limits and optional moderation
CAMPAIGN_REVIEW_REQUIRED=false
MAX_CAMPAIGN_CATEGORIES=5
MAX_CAMPAIGN_DELIVERABLES=20
MAX_CAMPAIGN_ATTACHMENTS=5
MAX_CAMPAIGN_ATTACHMENT_MB=10

# Rivera Phase 5 application fees (Stripe test mode for development)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_APPLICATION_FEE_ENABLED=true
DEFAULT_APPLICATION_FEE_MINOR=300
DEFAULT_APPLICATION_FEE_CURRENCY=USD
NEW_CREATOR_FREE_APPLICATIONS=3
APPLICATION_PAYMENT_EXPIRY_MINUTES=30

# Phase 9 operations (use false for one-off local API processes)
JOBS_ENABLED=true
RECONCILIATION_INTERVAL_SECONDS=300
COLLABORATION_FUNDING_DEADLINE_HOURS=48
ERROR_MONITORING_ENABLED=false
ERROR_MONITORING_DSN=
NEXT_PUBLIC_ERROR_MONITORING_ENABLED=false
SUPPORT_EMAIL=support@rivera.example
