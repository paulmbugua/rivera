  payoutsEnabled      Boolean             @default(false)
  detailsSubmitted    Boolean             @default(false)
  requirementsDueJson Json?
  lastSyncedAt        DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([onboardingStatus])
}

model CollaborationPayment {
  id                        String                     @id @default(cuid())
  campaignParticipantId     String                     @unique
  campaignParticipant       CampaignParticipant        @relation(fields: [campaignParticipantId], references: [id], onDelete: Restrict)
  campaignId                String
  campaign                  Campaign                   @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  businessId                String
  business                  BusinessProfile            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  creatorId                 String
  creator                   CreatorProfile             @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  provider                  PaymentProvider            @default(STRIPE)
  providerPaymentIntentId   String?                    @unique
  providerCheckoutSessionId String?                    @unique
  providerChargeId          String?                    @unique
  grossAmountMinor          Int
  currencyCode              String                     @db.VarChar(3)
  platformFeeMinor          Int
  providerFeeMinor          Int?
  creatorNetMinor           Int
  fundedAmountMinor         Int                        @default(0)
  refundedAmountMinor       Int                        @default(0)
  releasedAmountMinor       Int                        @default(0)
  status                    CollaborationPaymentStatus @default(NOT_FUNDED)
  fundedAt                  DateTime?
  eligibleForReleaseAt      DateTime?
  releasedAt                DateTime?
  settledAt                 DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  transfers                 CreatorTransfer[]
  refunds                   CollaborationRefund[]
  issues                    PaymentIssue[]

  @@index([businessId, status])
  @@index([creatorId, status])
  @@index([campaignId])
  @@index([status, updatedAt])
}

model CreatorTransfer {
  id                     String                @id @default(cuid())
  collaborationPaymentId String
  collaborationPayment   CollaborationPayment  @relation(fields: [collaborationPaymentId], references: [id], onDelete: Restrict)
  creatorId              String
  creator                CreatorProfile        @relation(fields: [creatorId], references: [id], onDelete: Restrict)
