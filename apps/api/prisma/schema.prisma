generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUSINESS
  CREATOR
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  OPEN
  PAUSED
  CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CampaignVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum CampaignLocationType {
  LOCAL
  NATIONAL
  GLOBAL
  REMOTE
}

enum CampaignObjective {
  BRAND_AWARENESS
  PRODUCT_LAUNCH
  SALES
  LEAD_GENERATION
  APP_DOWNLOADS
  WEBSITE_TRAFFIC
  STORE_VISITS
  EVENT_PROMOTION
  SOCIAL_ENGAGEMENT
  CONTENT_CREATION
  UGC_CREATION
  PRODUCT_REVIEWS
  COMMUNITY_GROWTH
  OTHER
}

enum BudgetVisibility {
  PUBLIC
  HIDDEN
}

enum UsageRights {
  ORGANIC_ONLY
  PAID_ADS
  BUSINESS_WEBSITE
  SOCIAL_MEDIA
  FULL_COMMERCIAL
  TO_BE_DISCUSSED
}

enum CampaignAttachmentVisibility {
  PUBLIC
  LOCKED
  OWNER_ONLY
}

enum ApplicationStatus {
  DRAFT
  PENDING_PAYMENT
  AWAITING_PAYMENT
  PAYMENT_PROCESSING
  SUBMITTED
  VIEWED
  OFFERED
  WITHDRAWN
  CANCELLED
  SHORTLISTED
  ACCEPTED
  REJECTED
}

enum PreferredContactMethod {
  RIVERA
  EMAIL
  PHONE
  WHATSAPP
}

enum ConversationType {
  CAMPAIGN
}

enum MessageType {
  TEXT
  SYSTEM
}

enum CollaborationOfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

enum CampaignParticipantStatus {
  ACTIVE
  CANCELLED
}

enum ApplicationPaymentStatus {
  NOT_REQUIRED
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  STRIPE
}

enum CreditTransactionType {
  GRANT
  USE
  REFUND
  ADMIN_ADJUSTMENT
}

enum WebhookEventStatus {
  PROCESSING
  PROCESSED
  FAILED
}

enum PaymentRefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PaymentRefundReason {
  DUPLICATE_PAYMENT
  TECHNICAL_ERROR
  CAMPAIGN_REMOVED
  CAMPAIGN_CANCELLED
  OTHER
}

enum ProfileVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  FACEBOOK
  X
  LINKEDIN
  SNAPCHAT
  TWITCH
  PINTEREST
  BLOG
  PODCAST
  OTHER
}

enum PortfolioMediaType {
  IMAGE
  VIDEO
  EXTERNAL_LINK
  ARTICLE
  SOCIAL_POST
}

enum LanguageProficiency {
  BASIC
  CONVERSATIONAL
  PROFESSIONAL
  NATIVE
}

enum EmployeeSize {
  SOLO
  TWO_TO_TEN
  ELEVEN_TO_FIFTY
  FIFTY_ONE_TO_TWO_HUNDRED
  TWO_HUNDRED_ONE_TO_FIVE_HUNDRED
  FIVE_HUNDRED_PLUS
}

enum VerificationProfileType {
  CREATOR
  BUSINESS
}

enum VerificationRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id                   String                   @id @default(cuid())
  email                String                   @unique
  passwordHash         String
  firstName            String
  lastName             String
  phone                String?
  countryCode          String?
  city                 String?
  profileImageUrl      String?
  status               UserStatus               @default(PENDING_VERIFICATION)
  emailVerifiedAt      DateTime?
  lastLoginAt          DateTime?
  deletedAt            DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  roles                UserRoleAssignment[]
  sessions             RefreshSession[]
  verificationTokens   EmailVerificationToken[]
  resetTokens          PasswordResetToken[]
  business             BusinessProfile?
  creator              CreatorProfile?
  verificationRequests VerificationRequest[]    @relation("VerificationOwner")
  verificationReviews  VerificationRequest[]    @relation("VerificationReviewer")
  notifications        Notification[]
  conversationMemberships ConversationParticipant[]
  messages             Message[]
}

model UserRoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      UserRole
  createdAt DateTime @default(now())

  @@unique([userId, role])
}

model RefreshSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userAgent String?
  ipAddress String?

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model BusinessProfile {
  id                       String                @id @default(cuid())
  userId                   String                @unique
  user                     User                  @relation(fields: [userId], references: [id])
  name                     String
  slug                     String                @unique
  country                  String
  city                     String                @default("")
  industry                 String                @default("")
  industryId               String?
  industryRef              Industry?             @relation(fields: [industryId], references: [id])
  description              String                @db.VarChar(3000)
  shortDescription         String?               @db.VarChar(240)
  website                  String?
  businessEmail            String?
  businessPhone            String?
  preferredContactMethod   PreferredContactMethod      @default(RIVERA)
  address                  String?
  logoUrl                  String?
  coverImageUrl            String?
  yearEstablished          Int?
  employeeSize             EmployeeSize?
  profileVisibility        ProfileVisibility     @default(PRIVATE)
  verificationStatus       VerificationStatus    @default(UNVERIFIED)
  profileCompletion        Int                   @default(0)
  averageRating            Decimal               @default(0) @db.Decimal(3, 2)
  ratingCount              Int                   @default(0)
  isFeatured               Boolean               @default(false)
  publishedAt              DateTime?
  onboardingCompleted      Boolean               @default(false)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  campaigns                Campaign[]
  verificationRequests     VerificationRequest[]
  applicationNotifications Notification[]        @relation("BusinessNotifications")
  collaborationOffers      CollaborationOffer[]
  campaignParticipants     CampaignParticipant[]

  @@index([country])
  @@index([industryId])
  @@index([profileVisibility, verificationStatus])
}

model CreatorProfile {
  id                       String                         @id @default(cuid())
  userId                   String                         @unique
  user                     User                           @relation(fields: [userId], references: [id])
  displayName              String
  slug                     String                         @unique
  headline                 String                         @default("") @db.VarChar(120)
  country                  String
  city                     String                         @default("")
  bio                      String                         @db.VarChar(2000)
  primaryCategory          String                         @default("")
  primaryPlatform          String                         @default("")
  profileImageUrl          String?
  coverImageUrl            String?
  websiteUrl               String?
  professionalContactEmail String?
  professionalPhone        String?
  preferredContactMethod   PreferredContactMethod       @default(RIVERA)
  yearsExperience          Int?
  travelAvailable          Boolean                        @default(false)
  remoteCampaignsAllowed   Boolean                        @default(true)
  minimumRateMinor         Int?
  minimumRateCurrency      String?                        @db.VarChar(3)
  profileVisibility        ProfileVisibility              @default(PRIVATE)
  verificationStatus       VerificationStatus             @default(UNVERIFIED)
  profileCompletion        Int                            @default(0)
  averageRating            Decimal                        @default(0) @db.Decimal(3, 2)
  ratingCount              Int                            @default(0)
  completedCampaigns       Int                            @default(0)
  isFeatured               Boolean                        @default(false)
  publishedAt              DateTime?
  onboardingCompleted      Boolean                        @default(false)
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt
  categories               CreatorCategory[]
  contentTypes             CreatorContentType[]
  languages                CreatorLanguage[]
  socialAccounts           CreatorSocialAccount[]
  portfolio                PortfolioItem[]
  verificationRequests     VerificationRequest[]
  savedCampaigns           SavedCampaign[]
  campaignApplications     CampaignApplication[]
  applicationPayments      ApplicationPayment[]
  creditTransactions       ApplicationCreditTransaction[]
  freeApplicationCredits   Int                            @default(0)
  applicationNotifications Notification[]                 @relation("CreatorNotifications")
  collaborationOffers      CollaborationOffer[]
  campaignParticipants     CampaignParticipant[]

  @@index([country])
  @@index([profileVisibility, verificationStatus])
}

model Category {
  id                  String               @id @default(cuid())
  name                String               @unique
  slug                String               @unique
  description         String?
  icon                String?
  active              Boolean              @default(true)
  sortOrder           Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  creators            CreatorCategory[]
  campaigns           CampaignCategory[]
  applicationFeeRules ApplicationFeeRule[]

  @@index([active, sortOrder])
}

model Industry {
  id         String            @id @default(cuid())
  name       String            @unique
  slug       String            @unique
  active     Boolean           @default(true)
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  businesses BusinessProfile[]

  @@index([active, sortOrder])
}

model ContentType {
  id                   String                @id @default(cuid())
  name                 String                @unique
  slug                 String                @unique
  active               Boolean               @default(true)
  sortOrder            Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  creators             CreatorContentType[]
  campaignDeliverables CampaignDeliverable[]

  @@index([active, sortOrder])
}

model CreatorCategory {
  creatorId  String
  categoryId String
  creator    CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  isPrimary  Boolean        @default(false)
  createdAt  DateTime       @default(now())

  @@id([creatorId, categoryId])
  @@index([categoryId])
}

model CreatorContentType {
  creatorId     String
  contentTypeId String
  creator       CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  contentType   ContentType    @relation(fields: [contentTypeId], references: [id], onDelete: Restrict)
  createdAt     DateTime       @default(now())

  @@id([creatorId, contentTypeId])
  @@index([contentTypeId])
}

model CreatorLanguage {
  id           String               @id @default(cuid())
  creatorId    String
  creator      CreatorProfile       @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  languageCode String               @db.VarChar(8)
  proficiency  LanguageProficiency?

  @@unique([creatorId, languageCode])
}

model CreatorSocialAccount {
  id               String         @id @default(cuid())
  creatorId        String
  creator          CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  platform         SocialPlatform
  username         String?
  profileUrl       String?
  followers        Int            @default(0)
  averageViews     Int?
  engagementRate   Decimal?       @db.Decimal(5, 2)
  verifiedByRivera Boolean        @default(false)
  isPrimary        Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([creatorId])
  @@index([platform])
}

model PortfolioItem {
  id           String             @id @default(cuid())
  creatorId    String
  creator      CreatorProfile     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title        String             @db.VarChar(140)
  description  String?            @db.VarChar(1000)
  mediaType    PortfolioMediaType
  mediaUrl     String?
  thumbnailUrl String?
  externalUrl  String?
  platform     SocialPlatform?
  brandName    String?            @db.VarChar(120)
  sortOrder    Int                @default(0)
  published    Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([creatorId, sortOrder])
}

model VerificationRequest {
  id                String                    @id @default(cuid())
  userId            String
  user              User                      @relation("VerificationOwner", fields: [userId], references: [id], onDelete: Cascade)
  profileType       VerificationProfileType
  creatorProfileId  String?
  creatorProfile    CreatorProfile?           @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  businessProfileId String?
  businessProfile   BusinessProfile?          @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  status            VerificationRequestStatus @default(PENDING)
  noteFromUser      String?                   @db.VarChar(1000)
  reviewNote        String?                   @db.VarChar(1000)
  reviewedById      String?
  reviewedBy        User?                     @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

model Campaign {
  id                          String                    @id @default(cuid())
  businessId                  String
  business                    BusinessProfile           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title                       String                    @db.VarChar(160)
  slug                        String                    @unique
  shortDescription            String                    @default("") @db.VarChar(350)
  fullDescription             String                    @default("") @db.VarChar(5000)
  productOrServiceName        String?                   @db.VarChar(160)
  productOrServiceDescription String?                   @db.VarChar(2000)
  productUrl                  String?
  campaignObjective           CampaignObjective?
  otherObjective              String?                   @db.VarChar(160)
  targetAudience              String?                   @db.VarChar(2000)
  expectedOutcomes            String?                   @db.VarChar(2000)
  budgetMinMinor              Int?
  budgetMaxMinor              Int?
  currencyCode                String                    @default("USD") @db.VarChar(3)
  budgetVisibility            BudgetVisibility          @default(PUBLIC)
  creatorSlots                Int                       @default(1)
  applicationDeadline         DateTime?
  campaignStartDate           DateTime?
  campaignEndDate             DateTime?
  locationType                CampaignLocationType?
  campaignCountryCode         String?                   @db.VarChar(2)
  campaignCity                String?
  campaignRegion              String?
  physicalLocationDescription String?                   @db.VarChar(500)
  verifiedCreatorsOnly        Boolean                   @default(false)
  usageRights                 UsageRights?
  usageRightsNotes            String?                   @db.VarChar(1000)
  productProvided             Boolean?
  travelExpensesCovered       Boolean?
  specialInstructions         String?                   @db.VarChar(2000)
  status                      CampaignStatus            @default(DRAFT)
  visibility                  CampaignVisibility        @default(PRIVATE)
  isFeatured                  Boolean                   @default(false)
  viewCount                   Int                       @default(0)
  publishedAt                 DateTime?
  pausedAt                    DateTime?
  closedAt                    DateTime?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  deletedAt                   DateTime?
  applications                CampaignApplication[]
  categories                  CampaignCategory[]
  creatorLocations            CampaignCreatorLocation[]
  platforms                   CampaignPlatform[]
  languages                   CampaignLanguage[]
  deliverables                CampaignDeliverable[]
  attachments                 CampaignAttachment[]
  savedBy                     SavedCampaign[]
  auditLogs                   CampaignAuditLog[]
  conversations               Conversation[]
  collaborationOffers         CollaborationOffer[]
  participants                CampaignParticipant[]

  @@index([status])
  @@index([visibility])
  @@index([publishedAt])
  @@index([createdAt])
  @@index([applicationDeadline])
  @@index([campaignCountryCode])
  @@index([businessId])
  @@index([campaignObjective])
}

model CampaignAuditLog {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  actorUserId String
  action      String   @db.VarChar(80)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([campaignId, createdAt])
  @@index([actorUserId])
}

model CampaignCategory {
  campaignId String
  categoryId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@id([campaignId, categoryId])
  @@index([categoryId])
}

model CampaignCreatorLocation {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  countryCode String   @db.VarChar(2)
  city        String?
  region      String?
  createdAt   DateTime @default(now())

  @@index([campaignId])
  @@index([countryCode, city])
}

model CampaignPlatform {
  id                 String         @id @default(cuid())
  campaignId         String
  campaign           Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  platform           SocialPlatform
  required           Boolean        @default(true)
  minimumFollowers   Int?
  preferredFollowers Int?
  createdAt          DateTime       @default(now())

  @@unique([campaignId, platform])
  @@index([platform])
}

model CampaignLanguage {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  languageCode String   @db.VarChar(8)
  required     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([campaignId, languageCode])
}

model CampaignDeliverable {
  id            String          @id @default(cuid())
  campaignId    String
  campaign      Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title         String          @db.VarChar(160)
  description   String?         @db.VarChar(1000)
  quantity      Int             @default(1)
  platform      SocialPlatform?
  contentTypeId String?
  contentType   ContentType?    @relation(fields: [contentTypeId], references: [id], onDelete: SetNull)
  dueDate       DateTime?
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([campaignId, sortOrder])
}

model CampaignAttachment {
  id         String                       @id @default(cuid())
  campaignId String
  campaign   Campaign                     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name       String
  fileUrl    String
  mimeType   String
  fileSize   Int
  visibility CampaignAttachmentVisibility @default(LOCKED)
  createdAt  DateTime                     @default(now())

  @@index([campaignId])
}

model SavedCampaign {
  creatorId  String
  campaignId String
  creator    CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  campaign   Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@id([creatorId, campaignId])
  @@index([creatorId])
  @@index([campaignId])
}

model CampaignApplication {
  id                         String                   @id @default(cuid())
  campaignId                 String
  campaign                   Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  creatorId                  String
  creator                    CreatorProfile           @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  proposedAmountMinor        Int
  proposedCurrencyCode       String                   @db.VarChar(3)
  pitch                      String                   @db.VarChar(1500)
  proposedDeliverables       String?                  @db.VarChar(3000)
  estimatedDeliveryDays      Int?
  additionalNotes            String?                  @db.VarChar(1500)
  status                     ApplicationStatus        @default(DRAFT)
  paymentStatus              ApplicationPaymentStatus @default(PENDING)
  applicationFeeMinor        Int?
  applicationFeeCurrencyCode String?                  @db.VarChar(3)
  applicationFeeRuleId       String?
  applicationFeeRule         ApplicationFeeRule?      @relation(fields: [applicationFeeRuleId], references: [id], onDelete: SetNull)
  usedFreeCredit             Boolean                  @default(false)
  submittedAt                DateTime?
  viewedAt                   DateTime?
  shortlistedAt              DateTime?
  rejectedAt                 DateTime?
  acceptedAt                 DateTime?
  withdrawnAt                DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  payments                   ApplicationPayment[]
  audits                     ApplicationAuditLog[]
  notifications              Notification[]
  conversation               Conversation?
  collaborationOffers        CollaborationOffer[]
  participant                CampaignParticipant?

  @@unique([campaignId, creatorId])
  @@index([campaignId])
  @@index([creatorId])
  @@index([status])
  @@index([submittedAt])
  @@map("Application")
}

model Conversation {
  id            String                    @id @default(cuid())
  campaignId    String
  campaign      Campaign                  @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  applicationId String                    @unique
  application   CampaignApplication       @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  type          ConversationType          @default(CAMPAIGN)
  lastMessageAt DateTime                  @default(now())
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  participants  ConversationParticipant[]
  messages      Message[]

  @@index([campaignId, lastMessageAt])
}

model ConversationParticipant {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  archivedAt     DateTime?

  @@id([conversationId, userId])
  @@index([userId, archivedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String?
  sender         User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)
  type           MessageType  @default(TEXT)
  content        String       @db.VarChar(3000)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt, id])
  @@index([senderId])
}

model CollaborationOffer {
  id                       String                   @id @default(cuid())
  applicationId            String
  application              CampaignApplication      @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  campaignId               String
  campaign                 Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  businessId               String
  business                 BusinessProfile          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  creatorId                String
  creator                  CreatorProfile           @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  version                  Int
  status                   CollaborationOfferStatus @default(DRAFT)
  compensationMinor        Int
  currencyCode             String                   @db.VarChar(3)
  deliverablesSummary      String                   @db.VarChar(3000)
  startDate                DateTime?
  endDate                  DateTime?
  deliveryDeadline         DateTime?
  usageRights              String?                  @db.VarChar(1000)
  additionalTerms          String?                  @db.VarChar(3000)
  expiresAt                DateTime?
  sentAt                   DateTime?
  acceptedAt               DateTime?
  declinedAt               DateTime?
  withdrawnAt              DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  participant              CampaignParticipant?

  @@unique([applicationId, version])
  @@index([applicationId, status])
  @@index([campaignId, status])
  @@index([creatorId, status])
}

model CampaignParticipant {
  id                        String                    @id @default(cuid())
  campaignId                String
  campaign                  Campaign                  @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  creatorId                 String
  creator                   CreatorProfile            @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  businessId                String
  business                  BusinessProfile           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  applicationId             String                    @unique
  application               CampaignApplication       @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  offerId                   String                    @unique
  offer                     CollaborationOffer        @relation(fields: [offerId], references: [id], onDelete: Restrict)
  status                    CampaignParticipantStatus @default(ACTIVE)
  agreedCompensationMinor   Int
  currencyCode              String                    @db.VarChar(3)
  joinedAt                  DateTime                  @default(now())
  endedAt                   DateTime?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  @@unique([campaignId, creatorId])
  @@index([campaignId, status])
  @@index([creatorId, status])
}

model ApplicationFeeRule {
  id           String                @id @default(cuid())
  name         String                @db.VarChar(120)
  countryCode  String?               @db.VarChar(2)
  categoryId   String?
  category     Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  amountMinor  Int
  currencyCode String                @db.VarChar(3)
  priority     Int                   @default(0)
  active       Boolean               @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  applications CampaignApplication[]

  @@index([active, priority])
  @@index([countryCode])
  @@index([categoryId])
}

model ApplicationPayment {
  id                        String                   @id @default(cuid())
  applicationId             String
  application               CampaignApplication      @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  creatorId                 String
  creator                   CreatorProfile           @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  campaignId                String
  provider                  PaymentProvider          @default(STRIPE)
  providerPaymentId         String?                  @unique
  providerCheckoutSessionId String?                  @unique
  amountMinor               Int
  currencyCode              String                   @db.VarChar(3)
  status                    ApplicationPaymentStatus @default(PENDING)
  failureCode               String?                  @db.VarChar(100)
  failureMessage            String?                  @db.VarChar(500)
  refundedAmountMinor       Int                      @default(0)
  expiresAt                 DateTime?
  paidAt                    DateTime?
  refundedAt                DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  refunds                   PaymentRefund[]

  @@index([applicationId])
  @@index([status])
  @@index([creatorId])
  @@index([campaignId])
}

model ApplicationCreditTransaction {
  id           String                @id @default(cuid())
  creatorId    String
  creator      CreatorProfile        @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  type         CreditTransactionType
  quantity     Int
  balanceAfter Int
  reason       String                @db.VarChar(240)
  referenceId  String?
  createdAt    DateTime              @default(now())

  @@unique([creatorId, type, referenceId])
  @@index([creatorId, createdAt])
}

model PaymentWebhookEvent {
  id              String             @id @default(cuid())
  provider        PaymentProvider
  providerEventId String
  eventType       String             @db.VarChar(120)
  status          WebhookEventStatus @default(PROCESSING)
  processedAt     DateTime?
  errorCode       String?            @db.VarChar(100)
  createdAt       DateTime           @default(now())

  @@unique([provider, providerEventId])
  @@index([providerEventId])
}

model PaymentRefund {
  id                 String              @id @default(cuid())
  paymentId          String
  payment            ApplicationPayment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  providerRefundId   String?             @unique
  amountMinor        Int
  currencyCode       String              @db.VarChar(3)
  reason             PaymentRefundReason
  note               String?             @db.VarChar(500)
  status             PaymentRefundStatus @default(PENDING)
  requestedByAdminId String
  createdAt          DateTime            @default(now())
  completedAt        DateTime?

  @@index([paymentId])
}

model ApplicationAuditLog {
  id            String              @id @default(cuid())
  applicationId String
  application   CampaignApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorUserId   String
  action        String              @db.VarChar(100)
  metadata      Json?
  createdAt     DateTime            @default(now())

  @@index([applicationId, createdAt])
}

model Notification {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatorId     String?
  creator       CreatorProfile?      @relation("CreatorNotifications", fields: [creatorId], references: [id], onDelete: Cascade)
  businessId    String?
  business      BusinessProfile?     @relation("BusinessNotifications", fields: [businessId], references: [id], onDelete: Cascade)
  applicationId String?
  application   CampaignApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String               @db.VarChar(80)
  title         String               @db.VarChar(160)
  body          String               @db.VarChar(500)
  readAt        DateTime?
  createdAt     DateTime             @default(now())

  @@index([userId, createdAt])
  @@index([applicationId])
}
